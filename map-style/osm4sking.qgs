            <rule key="{c0145e0a-8e58-4099-91e6-bbefe7a8901d}" checkstate="0" label="ice skating" symbol="11" filter="&quot;sport&quot; like  '%ice_skating%' "/>
            <rule key="{7c33614d-5522-4cb1-a712-ff6917e99da4}" checkstate="0" label="ice_rink" symbol="12" filter="&quot;leisure&quot; = 'ice_rink'"/>
