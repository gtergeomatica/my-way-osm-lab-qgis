          <rule scalemindenom="1" key="{c9935201-7307-477a-89d7-86a6f4884337}" label="ski_sport" scalemaxdenom="25001" symbol="8" filter="&quot;sport&quot; in ( 'ice_hockey' , 'ice_hockey;ice_skating;multi;curling;ice_stock' , 'ice_skating' , 'ice_skating;curling;ice_hockey' , 'ice_skating;ice_hockey' , 'ice_skating;ice_hockey;ice_stock' ,  'ice_skating;pattinaggio_a_rotelle' , 'skating' , 'ski' ) or &quot;leisure&quot; = 'ice_rink'">
